#
# How npm resolves and installs the frontend's packages
# (doc/adr/0022-repository-security-baseline.md).

# A release has to be out for seven days before npm takes it into the
# lockfile, the same week Dependabot waits (.github/dependabot.yml): an
# "npm install" or "npm update" run by hand resolves to nothing younger.
# "npm ci" installs what the lockfile names and asks no such question.
# A fix younger than that is taken by hand:
# npm install --min-release-age=0 <package>@<version>
min-release-age=7

# No package runs a script of its own when it is installed. Nothing the
# frontend uses needs one, and an install script is the first thing a
# compromised release runs. The scripts of package.json, "npm run build" and
# the others, are not affected.
ignore-scripts=true
